"sentences": [
{
"i": 0,
"t": 0.0,
"end": 4.872,
"text": "Si tu fixes une hélice de ventilateur au bout d'un manche à balai, en théorie, t'as déjà une éolienne."
},
{
"i": 1,
"t": 5.171,
"end": 9.526,
"text": "Sauf qu'au ras du sol, l'herbe et les haies freinent le vent, et ton ampoule clignote à peine."
},
{
"i": 2,
"t": 9.876,
"end": 12.262,
"text": "Alors tu montes ton hélice en haut d'un mât de cent mètres."
},
{
"i": 3,
"t": 12.462,
"end": 18.536,
"text": "Là-haut, le vent souffle plus fort, et sa puissance grimpe au cube : deux fois plus de vent, c'est huit fois plus d'énergie."
},
{
"i": 4,
"t": 18.886,
"end": 21.112,
"text": "Mais ta petite hélice n'attrape qu'un filet d'air."
},
{
"i": 5,
"t": 21.412,
"end": 26.865,
"text": "Alors tu lui fais des pales de soixante mètres. Double leur longueur, et tu balaies quatre fois plus de vent."
},
{
"i": 6,
"t": 27.165,
"end": 29.849,
"text": "Sauf qu'avec deux pales, tout ton mât tremble à chaque tour."
},
{
"i": 7,
"t": 30.149,
"end": 34.135,
"text": "Alors tu en mets trois, une tous les cent vingt degrés, et le rotor tourne bien rond."
},
{
"i": 8,
"t": 34.435,
"end": 39.141,
"text": "Mais ces pales géantes font à peine quinze tours par minute, et ta génératrice en réclame mille cinq cents."
},
{
"i": 9,
"t": 39.441,
"end": 44.972,
"text": "Alors tu glisses entre les deux une boîte de vitesses qui multiplie la rotation par cent. C'est le multiplicateur."
},
{
"i": 10,
"t": 45.322,
"end": 48.463,
"text": "D'ailleurs, si t'aimes savoir comment les choses marchent, abonne-toi."
},
{
"i": 11,
"t": 48.763,
"end": 52.702,
"text": "Mais le lendemain, le vent tourne, et ton éolienne se retrouve de profil."
},
{
"i": 12,
"t": 53.002,
"end": 57.129,
"text": "Alors tu poses une girouette sur le toit, et des moteurs qui font pivoter la nacelle face au vent."
},
{
"i": 13,
"t": 57.479,
"end": 61.918,
"text": "Puis arrive la tempête. À quatre-vingt-dix kilomètres-heure, tes pales s'emballent."
},
{
"i": 14,
"t": 62.218,
"end": 66.475,
"text": "Alors tu les fais tourner sur elles-mêmes pour qu'elles laissent filer le vent. C'est la mise en drapeau."
},
{
"i": 15,
"t": 66.825,
"end": 69.76,
"text": "Et comme c'est le point le plus haut du coin, la foudre tombe dessus."
},
{
"i": 16,
"t": 70.01,
"end": 73.512,
"text": "Alors tu caches dans chaque pale un câble en cuivre qui emmène l'éclair jusqu'au sol."
},
{
"i": 17,
"t": 73.862,
"end": 79.801,
"text": "Ajoute un socle de mille tonnes de béton, des feux rouges pour les avions, et félicitations, t'as construit une éolienne."
}
],
"duration": 79.801
}