"sentences": [
{
"i": 0,
"t": 0.0,
"end": 3.551,
"text": "Si tu poses une planche au-dessus d'une rivière, en théorie, t'as déjà un pont."
},
{
"i": 1,
"t": 3.901,
"end": 6.718,
"text": "Mais dès que tu marches au milieu, elle plie… et elle casse."
},
{
"i": 2,
"t": 7.168,
"end": 9.266,
"text": "Alors tu plantes un pilier au milieu de la rivière."
},
{
"i": 3,
"t": 9.466,
"end": 12.504,
"text": "La portée est deux fois plus courte, donc la planche plie huit fois moins."
},
{
"i": 4,
"t": 12.904,
"end": 16.504,
"text": "Mais au premier orage, la rivière gonfle, et le courant arrache ton pilier."
},
{
"i": 5,
"t": 16.954,
"end": 22.503,
"text": "Alors, plus rien dans l'eau. Tu montes une tour sur chaque rive, et tu tends un câble d'acier entre les deux."
},
{
"i": 6,
"t": 22.753,
"end": 25.565,
"text": "Tu y suspends la route avec des câbles verticaux : les suspentes."
},
{
"i": 7,
"t": 25.915,
"end": 28.832,
"text": "Mais le câble tire tellement fort qu'il couche les tours vers la rivière."
},
{
"i": 8,
"t": 29.232,
"end": 33.766,
"text": "Alors tu prolonges le câble derrière chaque tour, et tu l'ancres dans un énorme bloc de béton enterré."
},
{
"i": 9,
"t": 34.066,
"end": 35.927,
"text": "Et si t'as appris un truc, abonne-toi."
},
{
"i": 10,
"t": 36.227,
"end": 40.6,
"text": "Mais un jour de grand vent, ta route trop souple se met à onduler… se tord… et s'effondre."
},
{
"i": 11,
"t": 40.95,
"end": 44.493,
"text": "C'est exactement ce qui est arrivé au pont de Tacoma, en 1940."
},
{
"i": 12,
"t": 44.893,
